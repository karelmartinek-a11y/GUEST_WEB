{
  "name": "guest-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "tsc --noEmit && node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "acceptance": "node scripts/production-gate.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.13.0",
    "motion": "^12.35.0",
    "pmtiles": "^4.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
